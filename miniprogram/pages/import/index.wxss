.images { display: flex; flex-wrap: wrap; gap: 16rpx; }
.image-wrap { width: 144rpx; margin-bottom: 20rpx; }
.thumb { width: 144rpx; height: 168rpx; border-radius: 12rpx; background: #e1e7ed; }
.image-remove { font-size: 23rpx; padding: 12rpx; color: #9c2531; background: transparent; }
.consent { margin-top: 36rpx; color: #536373; font-size: 23rpx; line-height: 1.8; }
.consent label { display: flex; align-items: flex-start; }
.consent checkbox { flex-shrink: 0; transform: scale(.8); margin-left: -8rpx; }
.footer-note { text-align: center; margin-top: 24rpx; }
